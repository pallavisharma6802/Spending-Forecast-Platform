# Copy to .env for local runs (loaded automatically if you use python-dotenv,
# or export these yourself). On Render, set these as environment variables in
# the service dashboard instead - never commit a real .env.

# Claude API key (https://console.anthropic.com/). Powers the "Ask Your Data"
# chat tab and the narrative summary banner. Both features are hidden/skipped
# automatically if this is unset - the app still fully works without it.
ANTHROPIC_API_KEY=

# Comma-separated Kafka bootstrap servers. Unset -> the app falls back to an
# in-memory event bus (no broker needed, useful before you've set one up).
# For a managed broker (Upstash Kafka, Confluent Cloud - both have a free
# tier), also set the SASL fields below.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Optional model overrides.
AGENT_CHAT_MODEL=claude-sonnet-5
AGENT_NARRATIVE_MODEL=claude-haiku-4-5-20251001

# Optional PySpark local-mode tuning.
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=8
